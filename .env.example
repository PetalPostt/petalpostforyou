# Optional AWS S3 settings for persistent uploaded file storage
S3_BUCKET=your-bucket-name
AWS_REGION=your-aws-region
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# OpenAI API key for AI chatbot support
OPENAI_API_KEY=your-openai-api-key

# Example for local fallback
# No cloud storage credentials are required for local uploads.
